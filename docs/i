#!/usr/bin/env bash
set -euo pipefail

if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
  echo 'This installer supports Debian/Ubuntu Linux x86_64.' >&2
  exit 1
fi
command -v apt >/dev/null || { echo 'apt is required.' >&2; exit 1; }
curl -fsSL https://emirhanozdal.github.io/deskbridge/a | sudo sh
sudo apt install -y deskbridge
systemctl --user disable --now deskbridge.service >/dev/null 2>&1 || true
mkdir -p "$HOME/.config/autostart"
cp /usr/share/applications/deskbridge.desktop "$HOME/.config/autostart/deskbridge.desktop"
nohup /opt/deskbridge/DeskBridge >"${TMPDIR:-/tmp}/deskbridge-desktop.log" 2>&1 &
echo 'DeskBridge installed and started. No separate Deskflow application is required.'
