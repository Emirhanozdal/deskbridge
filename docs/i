#!/usr/bin/env bash
set -euo pipefail

if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
  echo 'This installer supports Debian/Ubuntu Linux x86_64.' >&2
  exit 1
fi
command -v apt >/dev/null || { echo 'apt is required.' >&2; exit 1; }
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
base=https://github.com/Emirhanozdal/deskbridge/releases/download/v0.1.3
curl -fL --retry 3 "$base/deskbridge_0.1.3_amd64.deb" -o "$tmpdir/deskbridge_0.1.3_amd64.deb"
curl -fsSL --retry 3 "$base/SHA256SUMS" -o "$tmpdir/SHA256SUMS"
(cd "$tmpdir" && sha256sum --check SHA256SUMS)
sudo apt install -y "$tmpdir/deskbridge_0.1.3_amd64.deb"
if ! command -v cloudflared >/dev/null 2>&1; then
  curl -fL --retry 3 https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb -o "$tmpdir/cloudflared.deb"
  sudo apt install -y "$tmpdir/cloudflared.deb"
fi
echo 'Installed. Run: deskbridge'
echo 'Keyboard/mouse sharing additionally requires Deskflow on both devices.'
